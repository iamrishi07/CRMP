<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <configSections>
    <section name="oracle.manageddataaccess.client"
             type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral"/>
  </configSections>

  <connectionStrings>
    <!--
      Update DATA SOURCE with your Oracle DSN or Easy Connect string:
      e.g. HOST:PORT/SERVICE_NAME  or  your TNS alias
    -->
    <add name="CRMPConnection"
         connectionString="User Id=CRMP_OWNER;Password=YOUR_PASSWORD;Data Source=YOUR_HOST:1521/YOUR_SERVICE;"
         providerName="Oracle.ManagedDataAccess.Client"/>
  </connectionStrings>

  <appSettings>
    <!-- Application -->
    <add key="AppName"           value="CRMP Portal"/>
    <add key="AppVersion"        value="1.0.0"/>
    <add key="OrganizationName"  value="Your Organization"/>

    <!-- File uploads -->
    <add key="UploadPath"        value="~/Uploads/"/>
    <add key="MaxUploadSizeMB"   value="10"/>
    <add key="AllowedExtensions" value=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.txt,.zip"/>

    <!-- Email / SMTP -->
    <add key="SmtpHost"          value="smtp.yourorg.local"/>
    <add key="SmtpPort"          value="25"/>
    <add key="SmtpUseSsl"        value="false"/>
    <add key="SmtpFromAddress"   value="crmp-noreply@yourorg.local"/>
    <add key="SmtpFromName"      value="CRMP Portal"/>
    <add key="SmtpUsername"      value=""/>
    <add key="SmtpPassword"      value=""/>

    <!-- SLA Engine — how often (minutes) the background SLA check runs -->
    <add key="SlaCheckIntervalMinutes" value="15"/>

    <!-- Daily digest — UTC hour to send (e.g. 2 = 2:00 AM UTC) -->
    <add key="DigestSendHourUtc"  value="2"/>

    <!-- Session timeout in minutes -->
    <add key="SessionTimeoutMinutes" value="60"/>

    <!-- Authentication mode: FORMS or WINDOWS -->
    <add key="AuthMode" value="FORMS"/>

    <!-- Pagination -->
    <add key="DefaultPageSize" value="20"/>

    <!-- Knowledge Base suggestion: minimum keyword match score (0-100) -->
    <add key="KbSuggestMinScore" value="30"/>
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.6"/>
    <httpRuntime targetFramework="4.6" maxRequestLength="20480" executionTimeout="300"/>

    <authentication mode="Forms">
      <forms loginUrl="~/Pages/Auth/Login.aspx"
             defaultUrl="~/Pages/Employee/Dashboard.aspx"
             timeout="60"
             slidingExpiration="true"
             cookieName=".CRMP_AUTH"
             protection="All"/>
    </authentication>

    <authorization>
      <deny users="?"/>
    </authorization>

    <sessionState mode="InProc" timeout="60"/>

    <customErrors mode="RemoteOnly" defaultRedirect="~/Pages/Shared/Error.aspx">
      <error statusCode="403" redirect="~/Pages/Shared/AccessDenied.aspx"/>
      <error statusCode="404" redirect="~/Pages/Shared/NotFound.aspx"/>
    </customErrors>

    <httpModules>
      <add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    </httpModules>

    <pages controlRenderingCompatibilityVersion="4.0">
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI" assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
        <add tagPrefix="crmp" tagName="NotificationBell"     src="~/Controls/NotificationBell.ascx"/>
        <add tagPrefix="crmp" tagName="RoleSwitcher"         src="~/Controls/RoleSwitcher.ascx"/>
        <add tagPrefix="crmp" tagName="SLABadge"             src="~/Controls/SLABadge.ascx"/>
        <add tagPrefix="crmp" tagName="RequestCard"          src="~/Controls/RequestCard.ascx"/>
        <add tagPrefix="crmp" tagName="TimelineControl"      src="~/Controls/TimelineControl.ascx"/>
        <add tagPrefix="crmp" tagName="DynamicForm"          src="~/Controls/DynamicForm.ascx"/>
        <add tagPrefix="crmp" tagName="ConnectionDirectory"  src="~/Controls/ConnectionDirectory.ascx"/>
      </controls>
    </pages>

    <globalization culture="en-GB" uiCulture="en-GB" fileEncoding="utf-8"
                  requestEncoding="utf-8" responseEncoding="utf-8"/>
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="TelemetryCorrelationHttpModule"/>
    </modules>
    <handlers>
      <add name="FileUploadHandler"      path="Handlers/FileUpload.ashx"      verb="POST" type="CRMP.Handlers.FileUploadHandler"/>
      <add name="FileDownloadHandler"    path="Handlers/FileDownload.ashx"    verb="GET"  type="CRMP.Handlers.FileDownloadHandler"/>
      <add name="NotificationHandler"    path="Handlers/NotificationPoll.ashx" verb="GET" type="CRMP.Handlers.NotificationPollHandler"/>
      <add name="ChartDataHandler"       path="Handlers/ChartData.ashx"       verb="GET"  type="CRMP.Handlers.ChartDataHandler"/>
      <add name="FormFieldHandler"       path="Handlers/FormFieldConfig.ashx" verb="GET"  type="CRMP.Handlers.FormFieldConfigHandler"/>
      <add name="DigestTriggerHandler"   path="Handlers/DigestTrigger.ashx"   verb="GET"  type="CRMP.Handlers.DigestTriggerHandler"/>
    </handlers>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00"/>
    </staticContent>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520"/>
      </requestFiltering>
    </security>
  </system.webServer>

  <location path="Pages/Auth">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Styles">
    <system.web><authorization><allow users="*"/></authorization></system.web>
  </location>
  <location path="Scripts">
    <system.web><authorization><allow users="*"/></authorization></system.web>
  </location>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Oracle.ManagedDataAccess"
                          publicKeyToken="89b483f429c47342" culture="neutral"/>
        <bindingRedirect oldVersion="4.122.0.0 - 4.122.65535.65535" newVersion="4.122.19.1"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
